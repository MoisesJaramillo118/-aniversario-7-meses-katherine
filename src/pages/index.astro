---
import Slideshow from '../components/Slideshow.tsx';
import MessageCards from '../components/MessageCards.tsx';
import DecorativeElements from '../components/DecorativeElements.tsx';
import AudioController from '../components/AudioController.tsx';
import { TitleAnimation } from '../components/TitleAnimation.tsx';
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>7 Meses de Nuestro Amor</title>
    <meta name="description" content="Celebrando 7 meses de amor, risas y momentos especiales juntos" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="relative min-h-screen bg-gradient-to-tr from-pink-100 to-white">
      {/* Decorative background elements inspired by modern design */}
      <div class="absolute inset-0 pointer-events-none">
        <DecorativeElements />
      </div>

      {/* Main content */}
      <div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-4 sm:px-6 lg:px-8">
        {/* Title Animation */}
        <TitleAnimation />

        {/* Audio Controller */}
        <div class="fixed top-4 right-4 z-20">
          <AudioController />
        </div>

        {/* Slideshow Section */}
        <section class="relative w-full max-w-4xl mt-16">
          <Slideshow />
        </section>

        {/* Message Cards Section */}
        <section class="relative w-full max-w-4xl mt-12 space-y-8">
          <MessageCards />
        </section>
      </div>

      {/* Audio Element */}
      <audio id="background-audio" loop preload="auto">
        <source src="/audio/iris-goo-goo-dolls-spanish.mp3" type="audio/mpeg" />
        Tu navegador no soporta el elemento de audio.
      </audio>
    </div>
  </body>
</html>